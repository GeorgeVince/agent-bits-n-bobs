{
  "name": "agent-bits-n-bobs",
  "version": "0.1.0",
  "description": "George's pi coding agent extensions, skills, prompts, and keybindings.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill"
  ],
  "pi": {
    "extensions": [
      "./pi/extensions",
      "./node_modules/ponytail/pi-extension/index.js"
    ],
    "skills": [
      "./pi/skills",
      "./node_modules/ponytail/skills"
    ],
    "prompts": [
      "./pi/prompts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.78.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pi-sandbox": "^0.4.3",
    "ponytail": "https://github.com/DietrichGebert/ponytail/archive/refs/tags/v4.7.0.tar.gz"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
