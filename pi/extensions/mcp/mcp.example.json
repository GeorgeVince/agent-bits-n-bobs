{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/georgevince/dev"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "signoz": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "SIGNOZ_URL", "-e", "SIGNOZ_API_KEY", "signoz/signoz-mcp-server:latest"],
      "env": {
        "SIGNOZ_URL": "${SIGNOZ_URL}",
        "SIGNOZ_API_KEY": "${SIGNOZ_API_KEY}"
      }
    },
    "signoz-binary": {
      "command": "signoz-mcp-server",
      "args": [],
      "env": {
        "SIGNOZ_URL": "${SIGNOZ_URL}",
        "SIGNOZ_API_KEY": "${SIGNOZ_API_KEY}",
        "LOG_LEVEL": "info"
      },
      "disabled": true
    },
    "signoz-self-hosted-http": {
      "url": "http://localhost:8000/mcp",
      "type": "http",
      "headers": {
        "SIGNOZ-API-KEY": "${SIGNOZ_API_KEY}"
      },
      "disabled": true
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    },
    "linear-api-key": {
      "url": "https://mcp.linear.app/mcp",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      },
      "disabled": true
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.notion.com/mcp"]
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.sentry.dev/mcp"],
      "description": "Sentry tools for organizations, projects, issues, events, releases, performance, and debugging production errors.",
      "autoEnable": false
    },
    "example-remote": {
      "url": "https://mcp.example.com/mcp",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${EXAMPLE_MCP_TOKEN}"
      },
      "disabled": true
    }
  }
}
