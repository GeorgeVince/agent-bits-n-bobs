{
  "enabled": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowedDomains": [
      "*.github.com",
      "*.githubusercontent.com",
      "*.npmjs.org",
      "registry.yarnpkg.com",
      "*.pypi.org",
      "*.pythonhosted.org",
      "*.aws.amazon.com",
      "*.linear.app",
      "*.notion.com",
      "*.notion.so",
      "mcp.sentry.dev",
      "*.sentry.io",
      "*.signoz.cloud",
      "*.signoz.io",
      "*.amazonaws.com",
      "localhost",
      "127.0.0.1"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      ".",
      "/tmp",
      "/private/tmp",
      "~/.config",
      "~/.local",
      "~/.cache",
      "~/.cache/uv",
      "~/.npm",
      "~/.mcp-auth",
      "~/.docker",
      "~/.pi",
      "~/.nine",
      "~/bin/nine",
      "~/dev/*",
      "~/Library/Keychains",
      "~/.gitconfig",
      "~/.gitignore_global",
      "~/.ssh/config",
      "~/.gnupg",
      "~/Library/Caches",
      "~/.nvm"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp",
      "~/.cache",
      "~/.cache/uv",
      "~/.npm",
      "~/.mcp-auth",
      "~/.docker",
      "~/.pi",
      "~/.gnupg",
      "~/Library/Caches"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "id_rsa",
      "id_ed25519",
      "~/.ssh/id_rsa",
      "~/.ssh/id_ed25519",
      "~/.ssh/*.pem",
      "~/.ssh/*.key"
    ]
  }
}
